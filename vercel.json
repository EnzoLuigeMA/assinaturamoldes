{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/v2", "destination": "/", "permanent": true },
    { "source": "/v3", "destination": "/", "permanent": true },
    { "source": "/v4", "destination": "/", "permanent": true },
    { "source": "/v5", "destination": "/", "permanent": true },
    { "source": "/v6", "destination": "/", "permanent": true },
    { "source": "/v7", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/quiz", "destination": "/quiz.html" },
    { "source": "/obrigado", "destination": "/obrigado.html" },
    { "source": "/obrigada", "destination": "/obrigado.html" },
    { "source": "/thank-you", "destination": "/obrigado.html" },
    { "source": "/comunidade", "destination": "/comunidade.html" },
    { "source": "/comunidade/obrigado", "destination": "/comunidade-obrigado.html" },
    { "source": "/comunidade/obrigada", "destination": "/comunidade-obrigado.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
